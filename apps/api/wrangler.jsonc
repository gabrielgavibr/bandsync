{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bandsync",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": [],
  "observability": { "enabled": true },
  "vars": {
    "APP_ENV": "development",
    "APP_URL": "http://localhost:5173",
    "PBKDF2_ITERATIONS": "100000",
    "RATE_LIMITS": "off"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bandsync",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "bandsync-files" }],
  "durable_objects": {
    "bindings": [
      { "name": "REHEARSAL", "class_name": "RehearsalSessionDO" },
      { "name": "MB_GATEWAY", "class_name": "MusicBrainzGatewayDO" },
      { "name": "PREPARE_JOB", "class_name": "PrepareJobDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RehearsalSessionDO"] },
    { "tag": "v2", "new_sqlite_classes": ["MusicBrainzGatewayDO", "PrepareJobDO"] }
  ],
  "env": {
    // Homologation / staging: separate Worker, database, bucket and Durable Object namespace.
    // D1 and R2 are created automatically by `wrangler deploy` (no IDs needed).
    // Secret required: STAGING_ACCESS_KEY (see docs/STAGING.md).
    "staging": {
      "name": "bandsync-staging",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "APP_ENV": "staging",
        "APP_URL": "",
        // Free-plan CPU budget (10 ms) cannot fit 100k iterations; staging passwords are random and long.
        "PBKDF2_ITERATIONS": "10000",
        "RATE_LIMITS": "on"
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "bandsync-staging", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "bandsync-files-staging" }],
      "durable_objects": {
        "bindings": [
          { "name": "REHEARSAL", "class_name": "RehearsalSessionDO" },
          { "name": "MB_GATEWAY", "class_name": "MusicBrainzGatewayDO" },
          { "name": "PREPARE_JOB", "class_name": "PrepareJobDO" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["RehearsalSessionDO"] },
        { "tag": "v2", "new_sqlite_classes": ["MusicBrainzGatewayDO", "PrepareJobDO"] }
      ],
      // No static-assets binding: the built web app is embedded in the bundle (scripts/embed-web.mjs)
      // and served by src/staging.ts after the access gate.
      "main": "src/staging.ts"
    },
    "production": {
      "vars": {
        "APP_ENV": "production",
        "APP_URL": "https://bandsync.example.com",
        "PBKDF2_ITERATIONS": "100000",
        "RATE_LIMITS": "on"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "bandsync-prod",
          "database_id": "REPLACE_WITH_PRODUCTION_D1_ID",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "bandsync-files-prod" }],
      "durable_objects": {
        "bindings": [
          { "name": "REHEARSAL", "class_name": "RehearsalSessionDO" },
          { "name": "MB_GATEWAY", "class_name": "MusicBrainzGatewayDO" },
          { "name": "PREPARE_JOB", "class_name": "PrepareJobDO" }
        ]
      },
      "assets": {
        "directory": "../web/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
      }
    }
  }
}

{
  "name": "@bandsync/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "wrangler types && tsc -p tsconfig.json && tsc -p test/tsconfig.json",
    "types": "wrangler types",
    "test": "wrangler types && vitest run",
    "db:migrate:local": "wrangler d1 migrations apply bandsync --local",
    "db:migrate:remote": "wrangler d1 migrations apply bandsync --remote",
    "db:seed:local": "wrangler d1 execute bandsync --local --file=./seed/demo.sql",
    "db:reset:local": "rm -rf .wrangler/state && wrangler d1 migrations apply bandsync --local",
    "staging:credentials": "node scripts/staging-credentials.mjs",
    "staging:deploy": "bash scripts/deploy-staging.sh",
    "staging:update": "bash scripts/update-staging.sh",
    "import:real-repertoire": "node scripts/import-real-repertoire.mjs"
  },
  "dependencies": {
    "@bandsync/shared": "workspace:*",
    "hono": "^4.13.17",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.1",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.159.0"
  }
}
